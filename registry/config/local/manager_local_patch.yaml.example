# Copy this file to manager_local_patch.yaml (gitignored) and fill in your
# own cluster's real values. Only the fields you list here get overridden;
# env vars are merged by name, so you don't need to repeat the full env list
# from config/manager/manager.yaml.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: regi-controller-manager
  namespace: registry-system
spec:
  template:
    spec:
      containers:
      - name: manager
        env:
        - name: BASE_DOMAIN
          value: "REPLACE_WITH_YOUR_REAL_BASE_DOMAIN"
        - name: STORAGE_CLASS
          value: "REPLACE_WITH_YOUR_REAL_STORAGE_CLASS"
        # Only if CERT_ISSUER is an internal CA you haven't wired into the
        # operator's trust store yet. Never set this to "true" in the
        # tracked config/manager/manager.yaml default.
        - name: HARBOR_INSECURE_TLS
          value: "true"
