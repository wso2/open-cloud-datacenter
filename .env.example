# Copy this file to .env and fill in your real values before running the suite.
# The project reads environment variables from the local .env file.

# Kubernetes / cluster access
export KUBECONFIG="$HOME/.kube/config"  # Path to your Harvester/Rancher kubeconfig
export HARVESTER_OPERATION_STRATEGY="crd"  # Use "crd" or "rest"

# Harvester cluster info
# Required for REST mode; optional when using the CRD path.
export HARVESTER_ENDPOINT="https://harvester.example.com"  # Harvester API endpoint
export RANCHER_API_KEY="token-xxxxx:xxxxxxxxxxxxxxxx"  # Rancher API token used by the tests
export RANCHER_ENDPOINT="https://rancher.example.com"  # Rancher management URL

# Optional direct auth fallback for Harvester
# export HARVESTER_USERNAME="admin"
# export HARVESTER_PASSWORD="your-password"

# VM image URLs used by VM/image tests
export OPENSUSE_IMAGE_URL="https://example.com/openSUSE-Leap-15.6.x86_64-NoCloud.qcow2"
export UBUNTU_IMAGE_URL="https://example.com/ubuntu-24.04-server-cloudimg-amd64.img"

# Existing cluster/resource names used by provisioning tests
export EXISTING_HARVESTER_NAME="cluster-id-or-name"  # Rancher/Harvester cluster reference
export EXISTING_IMAGE="images/ubuntu-22-04"  # Existing image name or ID
export EXISTING_NETWORK="namespace/network-name"  # Existing network reference

# Test timing / output
export WAIT_TIMEOUT=600  # Max seconds for test operations
export ROBOT_OUTPUT_DIR="./reports"

